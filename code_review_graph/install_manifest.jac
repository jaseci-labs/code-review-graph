import from __future__ { annotations }

import json;

import logging;

import os;

import tempfile;

import from collections.abc { Iterable }

import from pathlib { Path, PurePath, PurePosixPath }

glob logger: any;

glob DATA_DIR_NAME: any;

glob MANIFEST_NAME: any;

glob VERSION: any;

glob _DATA_DIR_GITIGNORE: any;

with entry {
    logger = logging.getLogger(__name__);

    DATA_DIR_NAME = ".code-review-graph";
    MANIFEST_NAME = "install-manifest.json";
    VERSION = 1;
    _DATA_DIR_GITIGNORE = "# Auto-generated by code-review-graph — do not commit database files.\n# The graph.db contains absolute paths and code structure metadata.\n*\n";
}

def manifest_path(repo_root: Path) -> Path;
def _relative(repo_root: Path, path: Path) -> str | None;
def relative_paths(repo_root: Path, paths: Iterable[Path]) -> list[str];
def _parse(text: str) -> list[str] | None;
def read(repo_root: Path) -> list[str];

def _render(files: Iterable[str]) -> str;
def plan_record(repo_root: Path, plan: install_plan.Plan);
def forget(repo_root: Path, paths: Iterable[Path]);
def _replace(path: Path, text: str);
